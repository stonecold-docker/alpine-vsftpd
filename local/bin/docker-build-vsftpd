#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="linux-pam"
PKG_DEV="linux-pam-dev"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing libpam-pwdfile"
mkdir -p /app/libpam-pwdfile
mkdir -p /build
cd /build
wget --no-check-certificate -q -O - https://github.com/tiwe-de/libpam-pwdfile/archive/master.tar.gz | tar zx
cd libpam-pwdfile-master
sed -i -e 's@/lib/security@/usr/lib/security@g' Makefile
make
make install DESTDIR=/app/libpam-pwdfile
cd /
rm -rf /build
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Moving output files"
mkdir -p /output
mv /app/libpam-pwdfile /output/
if [ -z "$(ls -A -- /app)" ]; then
	rm -rf /app
fi
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

