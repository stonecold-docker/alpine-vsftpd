#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="vsftpd openssl linux-pam"
docker-install -r -u ${PKG_LIB}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing libpam-pwdfile"
mkdir -p /etc/pam.d
cp /usr/local/etc/pam.d/vsftpd /etc/pam.d/vsftpd
mkdir -p /usr/lib/security
cp /app/libpam-pwdfile/usr/lib/security/pam_pwdfile.so /usr/lib/security/
rm -rf /app
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo


echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
mkdir -p /conf.d /data /conf.d/vsftpd
touch /conf.d/vsftpd/vsftpd.conf
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

